      "node_modules/@narumitw/pi-lsp/src/index.ts",
      "node_modules/@narumitw/pi-plan-mode/src/index.ts",
      "node_modules/@narumitw/pi-retry/src/index.ts",
      "node_modules/@narumitw/pi-subagents/src/index.ts",
      "node_modules/@narumitw/pi-sync/src/index.ts",
      "node_modules/@narumitw/pi-wait-what/src/wait-what.ts"
